# Copy this file to .env (or export these as real environment variables) before running the backend.
# Spring Boot does not load .env automatically — either `export` these in your shell,
# set them in your IDE's run configuration, or source this file from your shell profile.

# Gmail SMTP used for OTP / payment notification emails.
# Use a Gmail App Password (https://myaccount.google.com/apppasswords), not your account password.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Twilio SMS (optional — leave blank to disable SMS sending).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_DEFAULT_COUNTRY_CODE=+91

# JWT signing secret — must be at least 32 bytes. Generate your own before deploying.
JWT_SECRET=dev-only-change-this-secret-key-before-deploying-32bytes+
JWT_EXPIRATION_MINUTES=60
